# ========================================================
# LINE Messaging API 設定
# 請至 LINE Developers Console (https://developers.line.biz/)
# Basic settings 分頁取得 Channel Secret
# Messaging API 分頁取得 Channel Access Token (long-lived)
# ========================================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ========================================================
# Google Gemini API 設定
# 請至 Google AI Studio (https://aistudio.google.com/apikey) 免費取得 API Key
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================================
# 本地伺服器配置
# ========================================================
HOST=0.0.0.0
PORT=8000
